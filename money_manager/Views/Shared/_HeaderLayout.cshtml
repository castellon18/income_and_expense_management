@{
    string currentController()
    {
        return Convert.ToString(ViewContext?.RouteData?.Values["controller"]) ?? string.Empty;
    }

    string activeClass(string controllerName)
    {
        bool success = string.Equals(currentController(), controllerName, System.StringComparison.OrdinalIgnoreCase);

        if (success)
        {
            return "active";
        }
        return string.Empty;
    }
}

<nav class="navbar navbar-expand-lg bg-secondary" data-bs-theme="dark">
    <div class="container-fluid">
        <a class="navbar-brand text-white" asp-controller="Home" asp-action="Index">Money Manager</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarHeaderLayout" aria-controls="navbarHeaderLayout" aria-expanded="false">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarHeaderLayout">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a asp-controller="AccountTypes" asp-action="Index" class="nav-link @activeClass("AccountTypes")">Tipos Cuenta</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Accounts" asp-action="Index" class="nav-link @activeClass("Accounts")">Cuentas</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Categories" asp-action="Index" class="nav-link @activeClass("Categories")">Categorías</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Transactions" asp-action="Index" class="nav-link @activeClass("Transactions")">Transacciones</a>
                </li>
            </ul>
            <partial name="_LinksLogin" />
        </div>
    </div>
</nav>