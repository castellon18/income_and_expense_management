@model DetailedTransactionReportsViewModel;
@{
    SummaryOfAmountsViewModel viewModel = new SummaryOfAmountsViewModel()
    {
        Income = Model.BalanceDeposits,
        Bills = Model.ExpenseBalance,
        Total = Model.TotalBalance
    };
}
<partial name="_MonthsBrowser" model="@Model.StartDate" />

<partial name="_SummaryOfAmounts" model="@viewModel" />

@if (Model.GroupedTransactions.Count() == 0)
{
    <div class="alert alert-info mt-4" role="alert">
        No hay movimientos para mostrar.
    </div>
}
else
{
    <table class="table mt-4">
        <tbody>
            @foreach (var groupedTransaction in Model.GroupedTransactions)
            {
                <tr>
                    <td colspan="3">
                        @groupedTransaction.TransactionDate.Day
                        <span class="badge bg-primary">
                            @groupedTransaction.TransactionDate.ToString("dddd")
                        </span>
                    </td>

                    <td class="text-primary">
                        @groupedTransaction.BalanceDeposits.ToString("C")
                    </td>

                    <td class="text-danger">
                        @groupedTransaction.ExpenseBalance.ToString("C")
                    </td>
                </tr>

                @foreach (var transaction in groupedTransaction.Transactions)
                {
                    <tr>
                        <td>
                            <a asp-action="Edit" asp-controller="Transactions" asp-route-id="@transaction.TransactionId" asp-route-returnUrl="@ViewBag.returnUrl">
                                <i class="bi-pencil"></i>
                            </a>
                        </td>

                        <td>
                            @transaction.CategoryName
                        </td>

                        <td>
                            @transaction.AccountName
                        </td>

                        <td class="text-primary">
                            @(transaction.OperationTypeId == OperationTypeEntity.Ingreso ? transaction.Amount.ToString("C") : "")
                        </td>

                        <td class="text-danger">
                            @(transaction.OperationTypeId == OperationTypeEntity.Gasto ? transaction.Amount.ToString("C") : "")
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
