@model DateTime;

<div class="mt-4 d-flex justify-content-between align-items-center">
    <div>
        <a class="btn btn-outline-primary m-3" asp-action="Create" asp-controller="Transactions">
            Create Transaction
        </a>
    </div>

    <div>
        <a asp-route-month="@ViewBag.previousMonth" asp-route-year="@ViewBag.previousYear" class="btn btn-primary">
            <i class="bi-chevron-left"></i>
        </a>

        <strong class="mx-3">@Model.ToString("MMMM") - @Model.Year</strong>

        <a asp-route-month="@ViewBag.nextMonth" asp-route-year="@ViewBag.nextYear" class="btn btn-primary">
            <i class="bi-chevron-right"></i>
        </a>
    </div>
</div>