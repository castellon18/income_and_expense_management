@model LoginViewModel;
@{
    ViewData[index:"Title"] = "Login";
}
<div class="login-container">
    <h3 class="text-center mb-4">Iniciar Sesión</h3>
    <form asp-action="Login" asp-controller="Users" method="post">
        <div asp-validation-summary="ModelOnly" class="text-center m-2 alert alert-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="ejemplo@correo.com" autocomplete="off" />
            <span asp-validation-for="Email" class="text-danger m-1"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="PasswordHash"></label>
            <input asp-for="PasswordHash" class="form-control" placeholder="Contraseña" autocomplete="off" />
            <span asp-validation-for="PasswordHash" class="text-danger m-1"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
        </div>
        <button type="submit" class="btn btn-custom w-100">Ingresar</button>
    </form>
    <div class="text-center mt-3">
        <a asp-action="ForgotMyPassword" asp-controller="Users" class="text-secondary">¿Olvidaste tu contraseña?</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}