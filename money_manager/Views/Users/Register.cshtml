@model CreateUserViewModel;
@{
    ViewData[index:"Title"] = "Registro de Usuario";
}
<div class="border border-1 shadow rounded m-4 p-3">
    <form asp-action="Register" asp-controller="Users" method="post">
        <div class="card border border-0">
            <div class="card-header">
                <h2 class="card-title text-primary-emphasis fw-bold fs-3 text-center">
                    Registro de Usuario
                </h2>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-center m-2 alert alert-danger"></div>

                <div class="input-group mb-3">
                    <span class="input-group-text">
                        <i class="bi bi-person-circle text-primary"></i>
                    </span>

                    <div class="form-floating">
                        <input asp-for="UserAccountName" class="form-control" placeholder="Username">
                        <label asp-for="UserAccountName">Username</label>
                    </div>
                </div>
                <span asp-validation-for="UserAccountName" class="text-danger m-1"></span>

                <div class="input-group mb-3">
                    <span class="input-group-text">
                        <i class="bi bi-envelope-at-fill text-primary"></i>
                    </span>

                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" placeholder="example&#64domio.com">
                        <label asp-for="Email">Email</label>
                    </div>
                </div>
                <span asp-validation-for="Email" class="text-danger m-1"></span>

                <div class="input-group mb-3">
                    <span class="input-group-text">
                        <i class="bi bi-key-fill text-primary"></i>
                    </span>

                    <div class="form-floating">
                        <input asp-for="PasswordHash" class="form-control" placeholder="Password">
                        <label asp-for="PasswordHash">Password</label>
                    </div>
                </div>
                <span asp-validation-for="PasswordHash" class="text-danger m-1"></span>
            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-outline-success">Registro</button>
                <a asp-action="" asp-controller="" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}