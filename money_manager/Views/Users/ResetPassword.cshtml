@model ResetPasswordViewModel;
@{
    ViewData[index:"Title"] = "Reset Password";
}
<form asp-action="ResetPassword" asp-controller="Users" method="post">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Restablecer Contraseña</h2>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="card-body">
            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger m-1"></span>
            </div>

            <div class="form-group">
                <label asp-for="PasswordHash" class="form-label"></label>
                <input asp-for="PasswordHash" class="form-control" type="password" />
                <span asp-validation-for="PasswordHash" class="text-danger m-1"></span>
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Restablecer Contraseña</button>
        </div>
    </div>
</form>
