@model CategoryEntity;
@{
    ViewData[index:"Title"] = "Crear Categoria";
}
<div class=" border border-1 rounded shadow p-3 m-4">
    @Html.AntiForgeryToken()

    <h2 class="card-title text-primary text-center fw-bold">Crear Categoría</h2>

    <h5 class="card-subtitle mb-3 text-muted text-center">
        La categoría nos permite indicar en qué gastamos nuestro dinero, también de dónde
        provienen nuestros ingresos. Es importante crear categorías para tener un mejor control de nuestras finanzas.
    </h5>

    <div asp-validation-summary="ModelOnly" class="text-center m-2 alert alert-danger"></div>

    <form asp-controller="Categories" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input type="text"
                   class="form-control"
                   asp-for="CategoryName"
                   placeholder="Ingresa el nombre de la categoría"
                   autocomplete="off">
            <span asp-validation-for="CategoryName" class="text-danger m-1"></span>
        </div>

        <div class="mb-3">
            <label asp-for="OperationTypeId" class="form-label"></label>
            <select asp-for="OperationTypeId" asp-items="Html.GetEnumSelectList<OperationTypeEntity>()" class="form-select"></select>
            <span asp-validation-for="OperationTypeId" class="text-danger m-1"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-secondary" asp-controller="Categories" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}