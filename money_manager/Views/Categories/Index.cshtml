@model ResponsePaginationViewModel<CategoryEntity>;
@{
    ViewData["Title"] = "Categorias";
}
<div class="border border-1 rounded shadow p-2 m-3 w-100">

    @Html.AntiForgeryToken()

    <h2 class="card-title fw-bold text-center text-primary-emphasis">Listado Categorías</h2>

    <a asp-controller="Categories" asp-action="Create" class="btn btn-outline-primary">Create Category</a>

    @if (Model == null || !Model.Records.Any())
    {
        <div class="alert alert-info mt-3" role="alert">
            No hay categorías disponibles. Haz clic en "Crear Categoría" para agregar una nueva.
        </div>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table id="sortableTable" class="table table-primary table-striped table-hover">
                <thead class="table-secondary">
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Tipo Operación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    @foreach (CategoryEntity category in Model.Records)
                    {
                        <tr>
                            <td>@category.CategoryId</td>
                            <td>@category.CategoryName</td>
                            <td>@category.OperationTypeName</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.CategoryId">Editar</a>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(@category.CategoryId)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row">
            <div class="col-auto">
                <partial name="_Pagination" />
            </div>

            <div class="col-auto d-flex align-items-center">
                <label for="numberRecordsPerPage" class="me-3">Registros:</label>
                <select asp-for="@Model.RecordsPerPage" class="form-select" id="numberRecordsPerPage">
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const urlDelete = '@Url.Action("Delete", "Categories")';

        const deleteCategory = (categoryId = 0) => {
            Swal.fire({
                title: '¿Estás seguro de eliminar esta categoría?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    await deleteCategoryRequest(categoryId);
                }
            });
        }

        const deleteCategoryRequest = async (categoryId = 0) => {
            try {
                const response = await fetch(`${urlDelete}/${categoryId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });
                if (response.ok) {
                    Swal.fire({
                        title: 'Categoría eliminada',
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Error al eliminar la categoría',
                        text: 'Inténtalo de nuevo más tarde.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            } catch (error) {
                console.error("Error al eliminar la categoría:", error);
                Swal.fire({
                    icon: "error",
                    title: "Error de Conexión",
                    text: "Ocurrió un error de red o del servidor. Por favor, inténtelo de nuevo.",
                });
            }
        }

        const numberRecordsPerPageSelect = document.getElementById("numberRecordsPerPage");

        numberRecordsPerPageSelect.addEventListener("change", () => {
            const selectedValue = numberRecordsPerPageSelect.value;
            const url = new URL(window.location.href);
            url.searchParams.set("recordsPerPage", selectedValue);
            url.searchParams.set("page", 1);
            window.location.href = url.toString();
        });

    </script>
}